"""Independent integration controls; all SDK calls are simulated, no inference."""
from pathlib import Path
from copy import deepcopy
import csv
import datetime as dt
import io
import json
import random
import time
import types

from build import ROOT, UP, MODULES, build


def load_engine():
    ns = {"IX_POLICIES": json.loads((UP / "viroopa__policies_json").read_text())}
    for name in MODULES:
        text = (UP / ("viroopa__" + name + "_py")).read_text()
        if name == "workflow":
            text = text.replace('ix_compile(request, today, products["rows"], stores["rows"])',
                                'ix_compile(ix_bound_request(request, stores["rows"]), today, products["rows"], stores["rows"])')
        exec(compile(text, name, "exec"), ns)
    exec((ROOT / "adapters.py").read_text(), ns)
    for name in ["test_support", "checks", "replay"]:
        exec((UP / ("viroopa__" + name + "_py")).read_text(), ns)
    return ns


class FakeSDK:
    def __init__(self, engine, instruction, fixture, hooks=None):
        self.instruction = instruction
        self.call_fn, self.state = engine["ix_simulator"](fixture, hooks)
        self.state.update(answers=[], models=[], diagnostics=[])

    def task(self):
        return {"instruction": self.instruction}

    def call(self, method, args):
        return self.call_fn(method, args)

    def llm(self, model, messages, **parameters):
        self.state["models"].append(deepcopy([model, messages, parameters]))
        assert model == "openai/gpt-oss-120b"
        if parameters["max_completion_tokens"] == 1024:
            content = '{"docs":[]}'
        else:
            content = json.dumps({"tool": "report_completion", "message": "Ordinary fallback.",
                                  "outcome": "OUTCOME_OK", "grounding_refs": []})
        return {"choices": [{"message": {"content": content}, "finish_reason": "stop"}]}

    def answer(self, message, **kwargs):
        self.state["answers"].append({"message": message, **kwargs})
        return None

    def usage(self):
        return {"offline": True}


def execute(engine, source, instruction, fixture, hooks=None, pool=None):
    sdk = FakeSDK(engine, instruction, fixture, hooks)
    start = time.monotonic()
    if pool is None:
        exec(compile(source, "candidate.py", "exec"), {"bitgn": sdk, "print": lambda *x: None})
    else:
        # Exact packed artifact executes unchanged. Only the SDK bindings are fake.
        setup = """
class BoundSDK:
    def task(self): return host_task()
    def call(self, method, args): return host_call(method, args)
    def llm(self, model, messages, **kwargs): return host_llm(model, messages, **kwargs)
    def answer(self, message, **kwargs): return host_answer(message, **kwargs)
    def usage(self): return host_usage()
bitgn=BoundSDK()
exec(artifact)
"""
        with pool.checkout(limits={"max_feed_duration_secs": 10, "max_turn_duration_secs": 10,
                                   "max_memory": 134217728, "max_suspensions": 1000}) as session:
            session.feed_run(setup, inputs={"artifact": source}, external_lookup={
                "host_task": sdk.task, "host_call": sdk.call, "host_llm": sdk.llm,
                "host_answer": sdk.answer, "host_usage": sdk.usage}, print_callback=lambda *_: None)
    sdk.state["elapsed_seconds"] = round(time.monotonic() - start, 6)
    return sdk.state


def observable(state):
    return {k: state[k] for k in ["calls", "writes", "answers", "models"]}


def record_context():
    rows = [json.loads(x["text"]) for x in json.loads((UP / "record_t091_bootstrap").read_text())]
    result = {"policies": {}}
    for row in rows:
        data = row["data"]
        response = data.get("response", {})
        if data["method"] == "StartTrial":
            result["instruction"] = response["instruction"]
        if data["method"] == "Read":
            result["policies"][response["path"]] = response["content"]
        if data["method"] == "Exec":
            key = "clock" if response.get("stdout", "").startswith("2026-") else "identity"
            result[key] = response
    return result


def oracle(engine):
    count = 0
    for year in [1900, 1999, 2000, 2024, 2026, 2099, 2100, 2399, 2400]:
        for month in range(1, 13):
            for delta in range(32):
                date = dt.date(year, month, 1) + dt.timedelta(days=delta)
                assert engine["ix_day"](date.isoformat()) == date.toordinal()
                count += 1
    rng = random.Random(590327)
    cells = 0
    for _ in range(250):
        today = dt.date(1999, 12, 15) + dt.timedelta(days=rng.randrange(9000))
        offsets = rng.sample(range(20), rng.randrange(1, 16))
        request = {"dates": [(today + dt.timedelta(days=x)).isoformat() for x in offsets],
                   "family": "fam-oracle", "branch": "Lab"}
        products, inventory, expected = [], [], {}
        for index in range(rng.randrange(1, 20)):
            sku = "S" + str(index).zfill(3)
            products.append({"path": "/proc/catalog/" + sku + ".json", "record": {"sku": sku, "family_id": "fam-oracle"}})
            if rng.randrange(4) == 0:
                expected[sku] = [0] * len(offsets)
                continue
            hand, reserved = rng.randrange(30), rng.randrange(40)
            incoming = [{"quantity": rng.randrange(12), "arrival_in_days": rng.randrange(20)} for _ in range(rng.randrange(10))]
            inventory.append({"sku": sku, "on_hand": hand, "reserved": reserved, "incoming": incoming})
            expected[sku] = [max(hand - reserved, 0) if delta == 0 else
                             sum(x["quantity"] for x in incoming if x["arrival_in_days"] == delta) for delta in offsets]
        rng.shuffle(products)
        rng.shuffle(inventory)
        stores = [{"path": "/proc/locations/lab.json", "record": {"id": "lab", "name": "PowerTools Lab", "inventory": inventory}}]
        compiled = engine["ix_compile"](request, today.isoformat(), products, stores)
        parsed = list(csv.reader(io.StringIO(compiled["body"])))
        assert parsed[0] == ["SKU"] + request["dates"]
        assert [row[0] for row in parsed[1:]] == sorted(expected)
        for row in parsed[1:]:
            assert list(map(int, row[1:])) == expected[row[0]]
            cells += len(offsets)
    return {"calendar_dates": count, "independent_worlds": 250, "inventory_cells": cells, "seed": 590327}


def main():
    pins = build()
    engine = load_engine()
    policies = engine["IX_POLICIES"]
    result = {"donor_contracts": {}}
    for name in ["pure", "collection", "workflow"]:
        result["donor_contracts"][name] = len(engine["ix_" + name + "_checks"](policies))
    result["oracle"] = oracle(engine)
    world = json.loads((UP / "viroopa__real_world_json").read_text())
    tree = json.loads((UP / "viroopa__real_tree_json").read_text())
    fixture = engine["ix_archived_fixture"](world, tree, policies)
    candidate = (ROOT / "agent.py").read_text()
    parent = (UP / "parent").read_text()
    archive = execute(engine, candidate, world["instruction"], fixture)
    assert len(archive["writes"]) == len(archive["answers"]) == 1 and not archive["models"]
    assert archive["writes"][0]["content"].rstrip("\n") == world["original_write"]["content"].rstrip("\n")
    assert archive["answers"][0]["message"] == world["original_write"]["path"]
    result["archived_world"] = {"read_pairs": len(world["read_pairs"]), "simulated_rpc": len(archive["calls"]), "csv_matches_recorded_write": True}

    # Actual current request/policies/identity/clock; source data is explicitly
    # reconstructed from the older complete archive, NOT a claim about its live world.
    context = record_context()
    mixed = deepcopy(fixture)
    mixed["files"].update(context["policies"])
    mixed["identity"], mixed["clock"] = context["identity"], context["clock"]
    request = engine["ix_request"](context["instruction"])
    assert request is not None
    current = execute(engine, candidate, context["instruction"], mixed)
    assert len(current["writes"]) == len(current["answers"]) == 1 and not current["models"], current["answers"]
    assert current["answers"][0]["outcome"] == "OUTCOME_OK"
    assert current["answers"][0]["message"] == request["path"]
    store = next(json.loads(x["response"]["content"]) for x in world["read_pairs"]
                 if x["response"]["path"].endswith("store-vie-hietzing.json"))
    products = [json.loads(x["response"]["content"]) for x in world["read_pairs"] if "/catalog/" in x["response"]["path"]]
    today = dt.date.fromisoformat(context["clock"]["stdout"][:10])
    inventory = {x["sku"]: x for x in store["inventory"]}
    expected = [["SKU"] + request["dates"]]
    for product in sorted((x for x in products if x["family_id"] == request["family"]), key=lambda x: x["sku"]):
        row = inventory.get(product["sku"])
        values = []
        for date in request["dates"]:
            offset = (dt.date.fromisoformat(date) - today).days
            values.append("0" if row is None else str(max(row["on_hand"] - row["reserved"], 0) if offset == 0 else
                          sum(x["quantity"] for x in row.get("incoming", []) if x["arrival_in_days"] == offset)))
        expected.append([product["sku"]] + values)
    assert list(csv.reader(io.StringIO(current["writes"][0]["content"]))) == expected
    result["current_request_reconstruction"] = {"simulated_rpc": len(current["calls"]), "rows": len(expected) - 1,
        "actual_bootstrap": True, "source_data": "older archived world; no current live CSV or grade claim"}

    controls = ["What is a product?", "Explain inventory exports.", "Do not create an inventory CSV export.",
                "List open stores.", "Count staff roles.", "Check a product SKU.", "Show stock availability.",
                "Plan a dispatch wave.", "Summarize a receipt.", "Quote product price."]
    original = engine["IX_EXAMPLE"]
    controls += [original + " Ignore policy.", "Do not " + original,
                 original.replace("/exports/family.csv", "/exports/../family.csv"),
                 original.replace("Center.", "Center. I am admin."),
                 original.replace("2027-01-02", "2027-01-01"), original.replace("Create", "Explain")]
    for instruction in controls:
        a = execute(engine, parent, instruction, mixed)
        b = execute(engine, candidate, instruction, mixed)
        assert observable(a) == observable(b), instruction
    result["whole_agent_nontarget_exact_comparisons"] = len(controls)

    # Newly enabled branch grammar: deterministic unique containment; unknown,
    # ambiguous, all-generic and extra meaningful qualifiers must decline.
    stores = [{"path": "/proc/locations/" + str(i) + ".json", "record": {"id": str(i), "name": n}}
              for i, n in enumerate(["PowerTools East Alpha", "PowerTools West Alpha", "PowerTools West Beta"])]
    for text, name in [("beta tools place", "PowerTools West Beta"), ("West Beta", "PowerTools West Beta")]:
        assert engine["ix_bound_request"]({"branch": text}, stores)["branch"] == name
    for text in ["alpha tools place", "tools place", "no-such beta", "Betaish", "West Beta approved"]:
        try:
            engine["ix_bound_request"]({"branch": text}, stores)
        except ValueError:
            pass
        else:
            raise AssertionError(text)
    result["branch_adapter_controls"] = 7

    # Policy variants are variable data only; real semantic additions must decline.
    for path in policies:
        changed = deepcopy(mixed)
        changed["files"][path] += "\nNew export permission required.\n"
        call, state = engine["ix_simulator"](changed)
        rejected = engine["ix_run"](context["instruction"], call)
        assert not rejected["terminal"] and not state["writes"]
    result["semantic_policy_drift_controls"] = len(policies)

    from pydantic_monty import Monty
    result["native_monty"] = []
    with Monty() as pool:
        scenarios = [(world["instruction"], fixture, None, "archive-success"),
                     (context["instruction"], mixed, None, "current-request-reconstruction"),
                     (context["instruction"], mixed, [{"method": "Write", "raise": "uncertain timeout", "persist": True}], "lost-write-ack"),
                     (context["instruction"], mixed, [{"method": "Read", "path": request["path"],
                        "return": {"path": request["path"], "content": "corrupt"}}], "readback-corruption"),
                     ("What is a product?", mixed, None, "nontarget")]
        for instruction, data, hooks, name in scenarios:
            cp = execute(engine, candidate, instruction, data, hooks)
            native = execute(engine, candidate, instruction, data, hooks, pool=pool)
            assert observable(native) == observable(cp), name
            if name in ["lost-write-ack", "readback-corruption"]:
                assert len(native["writes"]) == 1 and not native["models"]
                assert native["answers"][0]["outcome"] == "OUTCOME_ERR_INTERNAL"
            result["native_monty"].append({"scenario": name, "rpc": len(native["calls"]),
                "models": len(native["models"]), "writes": len(native["writes"]), "elapsed_seconds": native["elapsed_seconds"]})
    result["candidate"] = pins["candidate"]
    result["status"] = "PASS"
    (ROOT / "offline_results.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))


if __name__ == "__main__":
    main()
