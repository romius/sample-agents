+def i2c_ah_list(text):
+    # return list of canonical ah keys present: '20','25','30','40','50','52' meaning 2.0, 2.5, 3.0, 4.0, 5.0, 5.2
+    s = text.lower().replace(" ", "")
+    out = []
+    i = 0
+    while i < len(s):
+        if s[i].isdigit():
+            j = i
+            while j < len(s) and (s[j].isdigit() or s[j] == "."):
+                j += 1
+            raw = s[i:j]
+            tail = s[j:j + 2]
+            if tail == "ah" or (j < len(s) and s[j:j + 2] == "ah"):
+                if "." in raw:
+                    a, b = raw.split(".", 1)
+                    key = a + (b[:1] if b else "0")
+                else:
+                    key = raw + "0"  # 5ah -> 50, 4ah -> 40, 3ah -> 30, 2ah -> 20
+                if key not in out and key in ("20", "25", "30", "40", "50", "52"):
+                    out.append(key)
+            i = j
+        else:
+            i += 1
+    return out
