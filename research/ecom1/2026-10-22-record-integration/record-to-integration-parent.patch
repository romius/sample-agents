+def i2c_eur_cap(q):
+    low = " ".join(q.lower().split())
+    for key in ("under eur ", "below eur ", "budget cap eur ", "price must be below eur "):
+        i = low.find(key)
+        if i < 0:
+            continue
+        rest = low[i + len(key):]
+        num = ""
+        for ch in rest:
+            if ch.isdigit() or (ch == "." and "." not in num):
+                num += ch
+            elif num:
+                break
+        if not num:
+            return None
+        if "." in num:
+            a, b = num.split(".", 1)
+            b = (b + "00")[:2]
+            return int(a) * 100 + int(b)
+        return int(num) * 100
+    return None
