+def i2c_stores():
+    if I2C["stores"] is None:
+        root = i2c_root("Stores")
+        out = []
+        if root:
+            files = i2c_files(root)
+            if not i2c_guard_dirs(files):
+                I2C["stores"] = []
+                return []
+            for p in files:
+                if p.endswith(".json"):
+                    r = i2c_json(p)
+                    if r is not None and r.get("id") and r.get("name"):
+                        r = dict(r)
+                        r["_path"] = p
+                        out.append(r)
+        I2C["stores"] = out
+    return I2C["stores"]
