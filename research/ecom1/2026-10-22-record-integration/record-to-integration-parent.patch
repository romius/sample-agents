+def i2c_files(root):
+    # all file paths under root (one Tree call per root, cached)
+    root = root.rstrip("/")
+    if root not in I2C["trees"]:
+        out = []
+        def walk(node, path):
+            for ch in node.get("children") or []:
+                p = path + "/" + ch.get("name", "")
+                if ch.get("kind") == "NODE_KIND_DIR":
+                    walk(ch, p)
+                else:
+                    out.append(p)
+        walk(bitgn.call("Tree", {"root": root, "level": 0}).get("root") or {}, root)
+        I2C["trees"][root] = out
+    return I2C["trees"][root]
+
+def i2c_guard_dirs(paths):
+    # nested AGENTS.MD / README.MD may carry extra rules -> decline
+    for p in paths:
+        if p.rsplit("/", 1)[-1].upper() in ("AGENTS.MD", "README.MD"):
+            return False
+    return True
