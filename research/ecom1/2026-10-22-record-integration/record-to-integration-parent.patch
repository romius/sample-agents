+def i2c_words(text):
+    out, cur = [], ""
+    for ch in str(text).lower():
+        if ch.isalnum():
+            cur += ch
+        else:
+            if cur:
+                out.append(cur)
+            cur = ""
+    if cur:
+        out.append(cur)
+    return out
+
+def i2c_agents():
+    return AGENTS_TEXT[0] if AGENTS_TEXT else ""
