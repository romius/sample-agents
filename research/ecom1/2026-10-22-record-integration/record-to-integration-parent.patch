+def i2c_tank_of(q):
+    low = q.lower()
+    # 24l, 24 l, 24-liter, 24 liter, 6-liter
+    for tok, n in (("24", 24), ("6", 6), ("50", 50)):
+        if tok + "l" in low.replace(" ", "").replace("-", "") and "liter" not in low and tok + "l" in i2c_flat(low):
+            pass
+    s = low.replace("-", " ")
+    # look for Nl or N liter
+    i = 0
+    found = None
+    squ = s.replace(" ", "")
+    if "240/24" in squ:
+        return 24
+    if "240/6" in squ:
+        return 6
+    while i < len(s):
+        if s[i].isdigit():
+            j = i
+            while j < len(s) and s[j].isdigit():
+                j += 1
+            n = int(s[i:j])
+            tail = s[j:j + 8]
+            if tail.startswith("l") or tail.startswith(" l") or tail.startswith(" liter"):
+                if n in (6, 24, 50):
+                    found = n
+            i = j
+        else:
+            i += 1
+    return found
