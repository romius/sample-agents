+def i2c_diam_of(q):
+    low = q.lower()
+    gt = eq = None
+    i = 0
+    while True:
+        j = low.find("mm", i)
+        if j < 0:
+            break
+        k = j - 1
+        if k >= 0 and low[k] == " ":
+            k -= 1
+        end = k + 1
+        while k >= 0 and low[k].isdigit():
+            k -= 1
+        if end - (k + 1) <= 3 and k + 1 < end:
+            n = int(low[k + 1:end])
+            pre = low[max(0, k - 8):k + 1]
+            if "above" in pre or "over" in pre:
+                gt = n
+            elif n >= 50 and "excluded" not in low[j:j + 24] and "excluded" not in pre:
+                eq = n
+        i = j + 2
+    return gt, eq
